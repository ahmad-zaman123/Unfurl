# The backend's public address: shown in the curl examples, and where the Vite dev server proxies /api.
# In production vercel.json passes /api/* to the deployed backend.
VITE_API_URL=http://127.0.0.1:8010

# Optional: shows "Continue with Google" on the sign-in page. Same client id as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
